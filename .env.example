# Preferred: OAuth Desktop client credentials. Run `tag-manager-auth` once.
GTM_AUTH_MODE=auto
GTM_OAUTH_CLIENT_SECRETS=/absolute/path/to/client_secret.json
GTM_OAUTH_TOKEN_FILE=/absolute/path/to/gtm-token.json

# Fallback: service account. Grant its email access in GTM first.
# GTM_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# GTM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional
GTM_LOG_LEVEL=INFO

# Quota guardrails. Google's published default is 25 requests per rolling 100 seconds.
GTM_MIN_REQUEST_INTERVAL_SECONDS=4.1
GTM_DAILY_REQUEST_BUDGET=9000
GTM_QUOTA_MAX_RETRIES=3
GTM_QUOTA_BACKOFF_SECONDS=5
# GTM_QUOTA_STATE_FILE=/absolute/path/to/quota-state.json

# SQLite debug logging (credentials and authorization data are redacted).
GTM_DEBUG_LOG_ENABLED=true
GTM_DEBUG_DB_PATH=/absolute/path/to/tag-manager-mcp/debug.db
GTM_DEBUG_RETENTION_DAYS=30
GTM_DEBUG_MAX_PAYLOAD_BYTES=262144
